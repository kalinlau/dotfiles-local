" vimtex
" as the author suggests, don't specify tex
" engine in vimtex, but use:
" 1). %!TeX program = xelatex
" 2). make a local latexmkrc add $pdf_mode=5 (My Prefer)
let g:tex_flavor = 'latex'
let g:vimtex_view_method = 'skim'
let g:vimtex_quickfix_mode=0
set conceallevel=1
let g:tex_conceal='abdmg'
let g:vimtex_compiler_latexmk = {
            \ 'build_dir' : 'build',
            \ 'executable' : 'latexmk',
            \ 'options' : [
                \ '-verbose',
                \ '-synctex=1',
                \ '-file-line-error',
                \ '-interaction=nonstopmode',
                \],
            \}

" line moving up/down.
" notice on mac:
"    <A-k> ==> ˚
"    <A-j> ==> ∆
nnoremap <A-down> :m .+1<CR>==
nnoremap <A-up> :m .-2<CR>==
inoremap <A-down> <Esc>:m .+1<CR>==gi
inoremap <A-up> <Esc>:m .-2<CR>==gi
vnoremap <A-down> :m '>+1<CR>gv=gv
vnoremap <A-up> :m '<-2<CR>gv=gv

" latex
set conceallevel=0

" --- cursor shape ---
" Only apply if running in a terminal (not GUI)
if !has("gui_running")

  " Normal Mode: Steady Block Cursor
  " t_EI: Terminal End Insert (when leaving Insert or Replace mode, returning to Normal)
  let &t_EI = "\e[2 q"

  " Insert Mode: Blinking Vertical Bar (I-beam)
  " t_SI: Terminal Start Insert (when entering Insert mode)
  let &t_SI = "\e[5 q"

  " Replace Mode: Steady Underline Cursor
  " t_SR: Terminal Start Replace (when entering Replace mode)
  let &t_SR = "\e[4 q"

  " Optional: Set cursor when Vim starts (t_ti) and exits (t_te)
  " This ensures your terminal cursor is set correctly when Vim launches
  " and restored when it quits. Use .= to append to existing values.
  let &t_ti .= "\e[2 q" " Set to steady block when Vim starts
  let &t_te .= "\e[0 q" " Restore to blinking block (terminal default) when Vim exits

endif
