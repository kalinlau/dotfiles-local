# --- ALIAS ---
alias ls='lsd --group-dirs first'
alias top='htop'
alias goproxy='export http_proxy=http://127.0.0.1:7892\
    https_proxy=http://127.0.0.1:7892'
alias disproxy='unset http_proxy https_proxy'

# --- Autojump ---
[ -f /usr/share/autojump/autojump.sh ] && source /usr/share/autojump/autojump.sh

# --- Bat ---
# https://github.com/sharkdp/bat
alias bat='bat --theme "Solarized (dark)" \
    --style="numbers,changes,header,grid"'
    alias bf='bat --diff'
    export MANPAGER="sh -c 'sed -u -e \"s/\\x1B\[[0-9;]*m//g; s/.\\x08//g\" \
        | bat -p -lman'"

# --- FZF ---
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
if [ -f ~/.fzfrc_local ]; then
    source ~/.fzfrc_local
fi

# ---  GnuPG ---
# @description: tool for secure encryption and digital signatures.
# Specify the TTY for passphrase prompts, needed for `git commit`
export GPG_TTY=$(tty)

# --- NPM ---
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# --- Pip ---
export PIP_REQUIRE_VIRTUALENV=false

# --- Rust ---
path_append "$HOME/.cargo/bin"
source "$HOME/.cargo/env"

# --- Snap ---
# @description: universal Linux packaging system developed by Canonical
path_append "/snap/bin"

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/home/liujialin/miniconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/home/liujialin/miniconda3/etc/profile.d/conda.sh" ]; then
        . "/home/liujialin/miniconda3/etc/profile.d/conda.sh"
    else
        export PATH="/home/liujialin/miniconda3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<

# >>>>> PUT THIS IN THE END >>>>>
for var in $(echo $PATH |sed 's/:/\n/g')
do
    [ ! -d $var ] && path_remove $var
done
