# alias for local mac
# command -v lsd &> /dev/null && alias ls='lsd --group-dirs first'
# command -v htop &> /dev/null && alias top='htop'
alias ls='lsd --group-dirs first'
alias top='htop'

alias goproxy='export http_proxy=http://127.0.0.1:7890 https_proxy=http://127.0.0.1:7892'
alias disproxy='unset http_proxy https_proxy'

# fzf: fuzzy search
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# autojump
# [ -f /opt/homebrew/etc/profile.d/autojump.sh ] && source /opt/homebrew/etc/profile.d/autojump.sh
[ -f /usr/share/autojump/autojump.sh ] && source /usr/share/autojump/autojump.sh

# Pip
export PIP_REQUIRE_VIRTUALENV=false

# Rust
path_append "$HOME/.cargo/bin"
source "$HOME/.cargo/env"

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/home/liujialin/miniconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/home/liujialin/miniconda3/etc/profile.d/conda.sh" ]; then
        . "/home/liujialin/miniconda3/etc/profile.d/conda.sh"
    else
        export PATH="/home/liujialin/miniconda3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<


# Remove Non-existed PATH,
# === PUT THIS IN THE END ===
for var in $(echo $PATH |sed 's/:/\n/g')
do
    [ ! -d $var ] && path_remove $var
done
